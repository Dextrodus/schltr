---
// One static page per view. Each renders the same interactive shell in the right state,
// so deep links work and moving between views stays animated client-side.
import Base from '../layouts/Base.astro';
import Site from '../components/Site';
import { allViews, pathFor, titleFor, type View } from '../lib/route';

export function getStaticPaths() {
  return allViews.map((view) => ({
    params: { path: pathFor(view).replace(/^\/|\/$/g, '') || undefined },
    props: { view },
  }));
}

const { view } = Astro.props as { view: View };
---

<Base title={titleFor(view)}>
  <Site client:load initial={view} />
</Base>
