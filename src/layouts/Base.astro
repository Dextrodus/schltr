---
import '../styles/site.css';
import coverLayout from '../lib/cover-layout.js?raw';
import { albums } from '../data/photos';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Konrad Schlüter: photography and software.' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <title>{title}</title>
    <script is:inline set:html={`${coverLayout}\nfitCovers(${albums.length});`} />
  </head>
  <body>
    <slot />
  </body>
</html>
