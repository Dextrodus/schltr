---
import '../styles/site.css';

interface Props {
  title: string;
  description?: string;
  /** Keep the page out of search engines (the 404 page). */
  noindex?: boolean;
}

const { title, description = 'Konrad Schlüter: photography and software.', noindex = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark" />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />}
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
