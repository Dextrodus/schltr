---
import '../styles/site.css';
import coverLayout from '../lib/cover-layout.js?raw';
import { albums } from '../data/photos';

interface Props {
  title: string;
  description?: string;
  /** Keep the page out of search engines (the 404 page). */
  noindex?: boolean;
}

const { title, description = 'Konrad Schlüter: photography and software.', noindex = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark" />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />}
    <title>{title}</title>
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {['Regular', 'Bold', 'Black'].map((w) => (
      <link rel="preload" href={`/fonts/avancement/Avancement2020-${w}.woff2`} as="font" type="font/woff2" crossorigin />
    ))}
    <script is:inline set:html={`${coverLayout}\nfitCovers(${albums.length});`} />
  </head>
  <body>
    <slot />
  </body>
</html>
